{
  "name": "statusflare",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Cloudflare status page and monitoring app, adapted from the UptimeFlare full-stack derivative. See NOTICE.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "node scripts/dev-worker.mjs",
    "preview": "npm run build && node scripts/dev-worker.mjs",
    "build": "tsc --noEmit && vite build",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "deploy": "npm run build && wrangler deploy",
    "configure:deploy": "node scripts/configure-deploy.mjs",
    "db:local": "wrangler d1 migrations apply STATUSFLARE_D1 --local",
    "db:remote": "wrangler d1 migrations apply STATUSFLARE_D1 --remote",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "^7.1.3",
    "@mantine/hooks": "^7.1.3",
    "chart.js": "^4.4.0",
    "jose": "^6.1.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.31",
    "postcss-preset-mantine": "^1.8.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.0.3",
    "typescript": "^5",
    "undici": "^7.29.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.132.0"
  }
}
